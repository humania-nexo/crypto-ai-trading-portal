# Configuración de Binance (Recomendado iniciar en Testnet o Paper Trading)
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui
BINANCE_TESTNET=true

# Modo de operación: 'paper' (simulado en memoria), 'testnet' (Binance Testnet), 'live' (Real con poco capital)
TRADING_MODE=paper

# Configuración de Riesgo
INITIAL_PAPER_BALANCE=100.0   # USD ficticios para pruebas
MAX_RISK_PER_TRADE_PERCENT=1.0 # Arriesgar máx 1% por trade
MAX_DAILY_LOSS_PERCENT=3.0     # Detener operaciones si se pierde 3% en un día
DEFAULT_TIMEFRAME=15m          # 1m, 5m, 15m, 1h, 4h, 1d
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# APIs de Noticias / Sentimiento (Opcional - CryptoPanic es gratuita)
CRYPTOPANIC_API_KEY=
